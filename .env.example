# -------------------------------------------------------------
# Toto Drive - Environment Variables Configuration
# -------------------------------------------------------------

# Supabase Client Configuration (Client-side / Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Server / Node Configuration (Server-side)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=your-supabase-service-role-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional Map Tile Providers
VITE_CARTO_API_KEY=
