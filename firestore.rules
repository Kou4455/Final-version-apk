rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all to prevent any unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    // Ping / connection health check
    match /test/{docId} {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema Validation Helpers
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.email is string && data.email.size() <= 120;
    }

    function isValidDriverProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.vehicleType in ['toto', 'bike', 'auto'] &&
             data.vehicleNumber is string && data.vehicleNumber.size() <= 30;
    }

    function isValidRide(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.status in ['idle', 'searching', 'driver_assigned', 'driver_arriving', 'driver_arrived', 'in_progress', 'completed', 'cancelled'] &&
             data.otp is string && data.otp.size() <= 6;
    }

    function isValidEarning(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.amount is number && data.amount >= 0;
    }

    function isValidApprovalRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverName is string && data.driverName.size() > 0 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.vehicleNumber is string && data.vehicleNumber.size() <= 30 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.fare is number && data.fare >= 0 &&
             data.status in ['completed', 'cancelled'];
    }

    function isValidRideRequest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.driverId is string && data.driverId.size() <= 128 &&
             data.status in ['searching', 'accepted', 'rejected', 'expired'];
    }

    // 1. Users collection: Passenger profiles
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // 2. Drivers collection: Toto Partner Captains
    match /drivers/{driverId} {
      allow get: if isValidId(driverId);
      allow list: if true;
      allow create: if isValidId(driverId) && isValidDriverProfile(incoming());
      allow update: if isValidId(driverId) && isValidDriverProfile(incoming());
      allow delete: if false;
    }

    // 3. Rides collection: Real-time trip matching & lifecycle
    match /rides/{rideId} {
      allow get: if isValidId(rideId);
      allow list: if true;
      allow create: if isValidId(rideId) && isValidRide(incoming());
      allow update: if isValidId(rideId) && isValidRide(incoming());
      allow delete: if isValidId(rideId);
    }

    // 4. Earnings collection: Driver ledger
    match /earnings/{earningId} {
      allow get: if isValidId(earningId);
      allow list: if true;
      allow create: if isValidId(earningId) && isValidEarning(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // 5. Driver Approvals collection: Driver registration queue for admin approval
    match /driver_approvals/{approvalId} {
      allow get: if isValidId(approvalId);
      allow list: if true;
      allow create: if isValidId(approvalId) && isValidApprovalRequest(incoming());
      allow update: if isValidId(approvalId) && isValidApprovalRequest(incoming());
      allow delete: if isValidId(approvalId);
    }

    // 6. Trips collection: Completed trips for dynamic earnings calculation
    match /trips/{tripId} {
      allow get: if isValidId(tripId);
      allow list: if true;
      allow create: if isValidId(tripId) && isValidTrip(incoming());
      allow update: if isValidId(tripId) && isValidTrip(incoming());
      allow delete: if isValidId(tripId);
    }

    // 7. Ride Requests collection: Real-time ride request alerts for driver banner
    match /rideRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if true;
      allow create: if isValidId(requestId) && isValidRideRequest(incoming());
      allow update: if isValidId(requestId) && isValidRideRequest(incoming());
      allow delete: if isValidId(requestId);
    }

    // 8. Support Tickets collection
    match /support_tickets/{ticketId} {
      allow get, list: if true;
      allow create, update: if isValidId(ticketId);
      allow delete: if isValidId(ticketId);
    }

    // 9. Saved Places collection
    match /saved_places/{placeId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(placeId);
    }

    // 10. Emergency Contacts collection
    match /emergency_contacts/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(contactId);
    }

    // 11. Coupons collection
    match /coupons/{couponId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(couponId);
    }

    // 12. Settings collection (dynamic pricing, service zones)
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId);
    }

    // 13. Admin Audit Logs collection
    match /admin_audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId);
    }

    // 14. Chat Messages collection
    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create, update: if isValidId(messageId);
    }

    // 15. Scheduled Rides collection
    match /scheduled_rides/{schedId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(schedId);
    }
  }
}
